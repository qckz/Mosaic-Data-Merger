{
  "output": {
    "path": "../output/indicator-notes.json",
    "format": "stix",
    "encoding": "utf-8",
    "columns": ["Title", "Content", "Source ID"],
    "atomic_write": true,
    "stix": {
      "object_type": "note",
      "properties": {
        "Title": "abstract",
        "Content": "content"
      },
      "static": {
        "object_refs": ["indicator--00000000-0000-4000-8000-000000000001"]
      },
      "timestamp": "2026-07-22T12:00:00.000Z"
    }
  },
  "inputs": [
    {
      "path": "../input/threat-intelligence.json",
      "format": "stix",
      "encoding": "utf-8",
      "mapping": {
        "name": "Title",
        "pattern": "Content",
        "id": "Source ID"
      },
      "on_malformed_row": "error"
    }
  ],
  "transformations": {
    "Title": [
      { "type": "trim" },
      { "type": "default_if_empty", "value": "Imported threat-intelligence item" }
    ]
  },
  "validation": {
    "on_error": "reject",
    "rejects_path": "../output/stix-rejects.csv",
    "rules": [
      { "column": "Title", "type": "required" },
      { "column": "Content", "type": "required" }
    ]
  }
}
